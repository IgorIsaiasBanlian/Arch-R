[Unit]
Description=Fluxbox Window Manager
Requires=xorg.service
After=xorg.service
Before=archr.target
StartLimitIntervalSec=0
[Service]
Environment=DISPLAY=:0
Environment=HOME=/storage
ExecStart=/usr/bin/fluxbox
KillMode=process
Restart=always
RestartSec=1
TimeoutStopSec=1s

[Install]
WantedBy=graphical.target
