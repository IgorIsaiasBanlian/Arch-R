# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

tocon "Starting services..."

for SERVICE in /usr/lib/autostart/daemons/*
do
  source ${SERVICE}


  if [ ! -d "/var/lib/archr/services" ]
  then
    mkdir -p "/var/lib/archr/services"
  fi

  if [ -n "${CONF}" ] && \
     [ -e "/var/lib/archr/services/${CONF}" ]
  then
    rm -f "/var/lib/archr/services/${CONF}"
  fi

  statemgr() {
    for daemon in ${DAEMONS[@]}
    do
      nohup systemctl ${1} ${daemon} &
    done
  }

  case "$STATE" in
    "1")
      touch "/var/lib/archr/services/${CONF}"
      statemgr start
    ;;
    *)
      statemgr stop
    ;;
  esac
done
