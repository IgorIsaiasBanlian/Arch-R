[Unit]
Description=Xorg Server
# kodi.service não existe em ArchR; o ordering Before= silenciosamente
# colapsava para Before=graphical.target. StartLimitInterval (alias
# antigo) precisa ficar em [Unit] para fazer efeito, e o canônico é
# StartLimitIntervalSec.
Before=graphical.target
After=multi-user.target
ConditionKernelCommandLine=!installer
StartLimitIntervalSec=0

[Service]
Type=notify
EnvironmentFile=-/run/archr/debug/xorg.conf
ExecStart=/usr/bin/xorg-launch -nolisten tcp vt01 $XORG_DEBUG
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
