. /etc/profile

# Em devices sem touchscreen (a maioria dos handhelds RK3326 — R33S,
# R36S, etc.) o while loop adiante nunca executa o ramo útil mas
# continua acordando a cada 5s para conferir as mesmas variáveis e
# voltar a dormir. Em um device de 1 GB RAM e quad Cortex-A35 cada
# wakeup desnecessário é overhead. Bail out cedo quando o quirk diz
# que não há touchscreen.
if [ "${DEVICE_HAS_TOUCHSCREEN}" != "true" ]; then
  exit 0
fi

TSKEY=$(get_setting "archr.touchscreen-keyboard.enabled")
if [ ! -n "${TSKEY}" ]; then
  set_setting "archr.touchscreen-keyboard.enabled" "1"
fi


while true; do
  TSKEY=$(get_setting "archr.touchscreen-keyboard.enabled")
  if [[ "${DEVICE_HAS_TOUCHSCREEN}" == "true" ]] && [[ "${TSKEY}" == "1" ]]; then
    PID="$(pidof wvkbd-mobintl)"
    if [  "$PID" != ""  ]; then
      killall wvkbd-mobintl
    elif [[ "${DEVICE_HAS_DUAL_SCREEN}" == "true" ]]; then
      secondary_output=$(swaymsg -t get_outputs -r | jq -r '.[] | select(.focused == false) | .name')
      swaymsg output ${secondary_output} power on
      if [[ ! "${QUIRK_DEVICE}" == "Anbernic RG DS" ]]; then
        tskb_height=720
        tskb_legend_size=35
      else
        tskb_height=350
        tskb_legend_size=18
      fi
      /usr/bin/wvkbd-mobintl -L ${tskb_height} -fg 6b6b75 -fg-sp 6b6b75 -bg 1d1d1d --text ffffff --text-sp ffffff -fn ${tskb_legend_size} -l simple --hidden --output ${secondary_output}
    else
      /usr/bin/wvkbd-mobintl -L 350 -fg 6b6b75 -fg-sp 6b6b75 -bg 1d1d1d --text ffffff --text-sp ffffff -fn 50 -l simple --hidden
    fi
  fi
  sleep 5
done
