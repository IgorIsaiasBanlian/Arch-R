[Unit]
Description=Setup User config dir
DefaultDependencies=no
After=systemd-tmpfiles-setup.service storage.mount
# autostart.service é nome herdado do JELOS; em ArchR a unit real é
# archr-autostart.service. Sem o prefixo o Before= é ignorado e
# userconfig-setup corria paralelo aos scripts de autostart.
Before=archr-automount.service archr-autostart.service
RequiresMountsFor=/storage

[Service]
Type=oneshot
ExecStart=/usr/bin/userconfig-setup
RemainAfterExit=yes
StandardOutput=journal+console

[Install]
WantedBy=sysinit.target
